# shfmt reads this file when it is run with no formatting flags, which is how
# the `.supertool.json` formatter and any CI leg call it. Keep the two in step:
# a flag on the command line makes shfmt ignore this file entirely.
root = true

[*]
end_of_line = lf
insert_final_newline = true

[*.sh]
indent_style = space
indent_size = 2
switch_case_indent = true
binary_next_line = true
space_redirects = true
